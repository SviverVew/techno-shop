@model ProductsListViewModel

<div class="mb-4">
    <h1><i class="fas fa-shopping-bags"></i> Sản phẩm công nghệ</h1>
    @if (!string.IsNullOrEmpty(Model?.CurrentCategory))
    {
        <p class="text-muted">Danh mục: <strong>@Model.CurrentCategory</strong></p>
    }
    @if (!string.IsNullOrEmpty(Model?.SearchQuery))
    {
        <p class="text-muted">Tìm kiếm: <strong>@Model.SearchQuery</strong></p>
    }
</div>

<div class="row g-4 mb-4">
    @foreach (var p in Model?.Products ?? Enumerable.Empty<Product>())
    {
        <div class="col-lg-3 col-md-4 col-sm-6">
            <partial name="ProductSummary" model="p" />
        </div>
    }
</div>

<nav aria-label="Page navigation" class="d-flex justify-content-center">
    <ul class="pagination">
        <div page-model="@Model?.PagingInfo" page-action="Index" page-classes-enabled="true"
             page-class="page-link" page-class-normal="text-dark" page-class-selected="active"
             page-url-category="@Model?.CurrentCategory!"
             page-url-search="@Model?.SearchQuery!" class="pagination">
        </div>
    </ul>
</nav>