@model Order

<h2><i class="fas fa-credit-card"></i> Thanh toán đơn hàng</h2>
<p class="text-muted">Vui lòng nhập thông tin của bạn, chúng tôi sẽ giao hàng ngay!</p>

<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Thông tin thanh toán</h5>
      </div>
      <div class="card-body">
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

        <form asp-action="Checkout" method="post">
          <!-- Thông tin liên hệ -->
          <h5 class="mb-3"><i class="fas fa-user"></i> Thông tin cá nhân</h5>
          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label">Họ tên <span class="text-danger">*</span></label>
              <input asp-for="Name" class="form-control" placeholder="Nhập họ tên" />
              <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
              <label class="form-label">Email <span class="text-danger">*</span></label>
              <input asp-for="Email" class="form-control" type="email" placeholder="Nhập email" />
              <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
            <input asp-for="Phone" class="form-control" type="tel" placeholder="Nhập số điện thoại" />
            <span asp-validation-for="Phone" class="text-danger small"></span>
          </div>

          <!-- Địa chỉ giao hàng -->
          <h5 class="mb-3"><i class="fas fa-map-marker-alt"></i> Địa chỉ giao hàng</h5>
          <div class="mb-3">
            <label class="form-label">Địa chỉ <span class="text-danger">*</span></label>
            <input asp-for="Line1" class="form-control" placeholder="Địa chỉ chính" />
            <span asp-validation-for="Line1" class="text-danger small"></span>
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label">Địa chỉ tiếp</label>
              <input asp-for="Line2" class="form-control" placeholder="Địa chỉ tiếp (tuỳ chọn)" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Địa chỉ thêm</label>
              <input asp-for="Line3" class="form-control" placeholder="Địa chỉ thêm (tuỳ chọn)" />
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label">Thành phố <span class="text-danger">*</span></label>
              <input asp-for="City" class="form-control" placeholder="Thành phố" />
              <span asp-validation-for="City" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
              <label class="form-label">Tỉnh <span class="text-danger">*</span></label>
              <input asp-for="State" class="form-control" placeholder="Tỉnh" />
              <span asp-validation-for="State" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
              <label class="form-label">Mã bưu điện</label>
              <input asp-for="Zip" class="form-control" placeholder="Mã bưu điện" />
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Quốc gia <span class="text-danger">*</span></label>
            <input asp-for="Country" class="form-control" placeholder="Quốc gia" />
            <span asp-validation-for="Country" class="text-danger small"></span>
          </div>

          <!-- Tùy chọn -->
          <h5 class="mb-3"><i class="fas fa-cogs"></i> Tùy chọn</h5>
          <div class="form-check mb-3">
            <input asp-for="GiftWrap" class="form-check-input" type="checkbox" id="giftWrap" />
            <label class="form-check-label" for="giftWrap">
              <i class="fas fa-gift"></i> Bao gói quà tặng
            </label>
          </div>

          <div class="d-grid gap-2 mt-4">
            <button type="submit" class="btn btn-primary btn-lg">
              <i class="fas fa-check-circle"></i> Hoàn tất đơn hàng
            </button>
            <a href="/Cart" class="btn btn-outline-secondary">
              <i class="fas fa-arrow-left"></i> Quay lại giỏ hàng
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card sticky-top">
      <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="fas fa-box"></i> Tóm tắt đơn</h5>
      </div>
      <div class="card-body">
        <p class="text-muted">Đơn hàng sẽ được xác nhận trong 24 giờ</p>
        <hr>
        <p class="text-muted small">
          <i class="fas fa-shipping-fast"></i> Giao hàng miễn phí cho đơn trên 500.000đ
        </p>
      </div>
    </div>
  </div>
</div>
