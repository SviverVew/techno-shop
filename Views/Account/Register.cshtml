@model User

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="fas fa-user-plus"></i> Đăng ký tài khoản</h4>
                </div>
                <div class="card-body p-5">
                    <form method="post">
                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Name">Tên đăng nhập</label>
                            <input class="form-control form-control-lg" asp-for="Name" placeholder="Nhập tên đăng nhập">
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Email">Email</label>
                            <input class="form-control form-control-lg" asp-for="Email" type="email" placeholder="Nhập email">
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Password">Mật khẩu</label>
                            <input class="form-control form-control-lg" asp-for="Password" type="password" placeholder="Nhập mật khẩu">
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <small class="form-text text-muted">Ít nhất 6 ký tự</small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label" asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                            <input class="form-control form-control-lg" asp-for="ConfirmPassword" type="password" placeholder="Nhập lại mật khẩu">
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-user-plus"></i> Tạo tài khoản
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <p class="text-muted mb-0">
                                Đã có tài khoản? 
                                <a href="/Account/Login" class="text-primary">Đăng nhập</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
