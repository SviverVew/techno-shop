@model Cart

<div class="dropdown">
    <button class="btn btn-outline-light dropdown-toggle" type="button" id="cartDropdown" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fas fa-shopping-cart"></i> 
        Giỏ hàng
        @if (Model?.Lines.Count > 0)
        {
            <span class="badge bg-danger">@Model.Lines.Count</span>
        }
    </button>
    <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 300px;" aria-labelledby="cartDropdown">
        @if (Model?.Lines.Count() == 0)
        {
            <p class="text-muted mb-0">Giỏ hàng trống</p>
        }
        else
        {
            <div style="max-height: 300px; overflow-y: auto;">
                @foreach (var line in Model!.Lines)
                {
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                        <div>
                            <small><strong>@line.Product?.Name</strong></small><br />
                            <small class="text-muted">Số lượng: @line.Quantity</small>
                        </div>
                        <div class="text-end">
                            <small><span price="@(line.Product!.Price * line.Quantity)"></span></small>
                        </div>
                    </div>
                }
            </div>
            <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between mb-3">
                    <strong>Tổng cộng:</strong>
                    <strong><span price="@Model.ComputeTotalValue()"></span></strong>
                </div>
                <a href="/Cart" class="btn btn-primary btn-sm w-100 mb-2">Xem giỏ hàng</a>
                <a href="/Order/Checkout" class="btn btn-success btn-sm w-100">Thanh toán</a>
            </div>
        }
    </div>
</div>
