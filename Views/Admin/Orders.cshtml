@model IEnumerable<TechnoShop.Models.Order>
@{ Layout = "_Layout"; }

<div class="container mt-4">
    <h2>Quản lý đơn hàng</h2>
    <p class="text-muted">Duyệt đơn và xác nhận giao hàng.</p>

    @if (TempData["message"] != null)
    {
        <div class="alert alert-success">@TempData["message"]</div>
    }

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Email</th>
                <th>Khách hàng</th>
                <th>Ngày</th>
                <th>Tổng tiền</th>
                <th>Thanh toán</th>
                <th>Giao hàng</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr class="@(order.Shipped ? "table-success" : "")">
                    <td>@order.OrderID</td>
                    <td>@order.Email</td>
                    <td>@order.Name<br /><small class="text-muted">@order.Phone</small></td>
                    <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@order.TotalPrice.ToString("c")</td>
                    <td>@order.PaymentStatus</td>
                    <td>@(order.Shipped ? "Đã giao" : "Chưa giao")</td>
                    <td>
                        <div class="btn-group" role="group">
                            @if (order.PaymentStatus != "Approved")
                            {
                                <form asp-action="Approve" method="post" class="d-inline">
                                    <input type="hidden" name="orderId" value="@order.OrderID" />
                                    <button type="submit" class="btn btn-sm btn-warning">Duyệt</button>
                                </form>
                            }
                            @if (!order.Shipped)
                            {
                                <form asp-action="MarkShipped" method="post" class="d-inline ms-1">
                                    <input type="hidden" name="orderId" value="@order.OrderID" />
                                    <button type="submit" class="btn btn-sm btn-primary">Xác nhận giao</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
