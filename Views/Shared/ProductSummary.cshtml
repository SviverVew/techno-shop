@model Product

<div class="card product-card h-100">
    <img product-image="@Model?.ImageUrl" alt="@Model?.Name" class="product-image">
    
    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Model?.Name</h5>
        
        @if (!string.IsNullOrEmpty(Model?.Brand))
        {
            <p class="card-text text-muted small">
                <strong>Hãng:</strong> @Model.Brand
            </p>
        }
        
        <p class="card-text small flex-grow-1">
            @Model?.Description
        </p>
        
        @if (!string.IsNullOrEmpty(Model?.Specification))
        {
            <p class="card-text small text-secondary">
                <strong>Specs:</strong> @Model.Specification
            </p>
        }
        
        <div class="d-flex justify-content-between align-items-center mt-2">
            <span price="@Model!.Price" class="price-display"></span>
            @if (Model.StockQuantity > 0)
            {
                <small class="text-success"><i class="fas fa-check-circle"></i> Còn hàng</small>
            }
            else
            {
                <small class="text-danger"><i class="fas fa-times-circle"></i> Hết hàng</small>
            }
        </div>
    </div>

    <form id="@Model?.ProductID" asp-page="/Cart" method="post" class="w-100">
        <input type="hidden" asp-for="ProductID" />
        <input type="hidden" name="returnUrl" value="@ViewContext.HttpContext.Request.PathAndQuery()" />
        <div class="card-footer bg-white border-top">
            <button type="submit" class="btn btn-sm btn-primary w-100" @(Model?.StockQuantity > 0 ? "" : "disabled")>
                <i class="fas fa-shopping-cart"></i> Thêm vào giỏ hàng
            </button>
        </div>
    </form>
</div>