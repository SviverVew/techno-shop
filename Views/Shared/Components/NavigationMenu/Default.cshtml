@model IEnumerable<string>
<div class="category-list">
    <a class="category-item @(String.IsNullOrEmpty(ViewBag.SelectedCategory) ? "active" : "")" asp-action="Index" asp-controller="Home" asp-route-category="">
        <i class="fas fa-home me-2"></i> Tất cả
    </a>
    @foreach (string category in Model ?? Enumerable.Empty<string>())
    {
        var isActive = category == ViewBag.SelectedCategory ? "active" : "";
        <a class="category-item @isActive" asp-action="Index" asp-controller="Home" asp-route-category="@category" asp-route-productPage="1">
            <i class="fas fa-tag me-1"></i> @category
        </a>
    }
</div>