<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>TechnoShop - Cửa hàng công nghệ</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.3.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #3f51b5;
            --secondary-color: #1a73e8;
            --accent-color: #00bcd4;
            --bg-color: #f8fafc;
            --text-color: #2f3b4f;
            --muted-color: #64748b;
            --surface-color: #ffffff;
            --border-color: #e4e7eb;
        }
        
        html, body {
            height: 100%;
        }

        body {
            background: var(--bg-color);
            color: var(--text-color);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .content-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        header {
            background: linear-gradient(90deg, #1f3a93 0%, #2a4fc7 100%);
            color: #ffffff;
            box-shadow: 0 4px 16px rgba(39, 76, 154, 0.28);
        }

        .navbar-brand {
            font-size: 24px;
            font-weight: bold;
        }

        .navbar-brand i {
            margin-right: 10px;
        }

        .nav-link {
            color: rgba(255,255,255,0.9) !important;
            border-radius: 8px;
            margin: 0 0.2rem;
            padding: 0.45rem 0.8rem;
            font-weight: 600;
            border: 1px solid transparent;
            transition: all 0.22s ease;
        }

        .nav-link:hover,
        .nav-link:focus {
            color: #1f2f4e !important;
            background: #f8fafc;
            border-color: rgba(255,255,255,0.45);
            box-shadow: 0 5px 14px rgba(0,0,0,0.14);
        }

        .btn-nav {
            border-radius: 8px;
            min-width: 120px;
            padding: 0.42rem 0.9rem;
            border-width: 1px;
            font-weight: 600;
            box-shadow: 0 3px 12px rgba(0,0,0,0.15);
            transition: all 0.22s ease;
        }

        .btn-nav-primary {
            background: #ffffff;
            color: var(--text-color);
            border-color: #dfe7f5;
        }

        .btn-nav-primary:hover {
            background: #e8edfb;
            color: var(--text-color);
            border-color: #bfd2f8;
        }

        .btn-nav-ghost {
            background: transparent;
            color: #ffffff;
            border-color: rgba(255,255,255,0.4);
        }

        .btn-nav-ghost:hover {
            background: rgba(255,255,255,0.15);
            color: #ffffff;
        }

        .categories-section {
            background: linear-gradient(135deg, #e9f0ff 0%, #f6fcff 100%);
            border: 1px solid #dce8ff;
            border-radius: 14px;
            padding: 15px;
            margin-bottom: 20px;
            box-shadow: 0 6px 18px rgba(0, 71, 123, 0.1);
        }

        .category-list {
            display: grid;
            grid-template-columns: 1fr;
            gap: 8px;
        }

        .category-item {
            display: flex;
            align-items: center;
            padding: 10px 14px;
            border-radius: 12px;
            border: 1px solid #a1c2ff;
            background: #e9f2ff;
            color: #113e8b;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(41, 88, 216, 0.17);
        }

        .category-item:hover {
            transform: translateY(-1px);
            background: #d7e8ff;
            border-color: #73a1ff;
            color: #0f336c;
        }

        .category-item.active {
            background: linear-gradient(90deg, #3f5fd0, #2a4ec5);
            color: #ffffff;
            border-color: #2e4db9;
            box-shadow: 0 6px 16px rgba(25, 69, 163, 0.35);
        }

        .category-item.active i {
            color: #ffd966;
        }

        .product-card {
            transition: all 0.3s;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            overflow: hidden;
        }

        .product-card:hover {
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            transform: translateY(-5px);
        }

        .product-image {
            height: 200px;
            object-fit: cover;
            background: #f0f0f0;
        }

        .price-display {
            font-size: 20px;
            font-weight: bold;
            color: var(--primary-color);
        }

        footer {
            background: #0f2b4f;
            color: #d6e3ff;
            padding: 20px 0;
            margin-top: auto;
            border-top: 1px solid #244a7a;
            box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.1);
        }

        footer a {
            color: #a3c5ff;
            text-decoration: none;
        }

        footer a:hover {
            text-decoration: underline;
            color: #ffffff;
        }

        .footer-link {
            color: #c7d8ff;
        }

        .footer-link:hover {
            color: #ffffff;
        }

        .footer-title {
            color: white;
            margin-bottom: 15px;
        }

        .main-content {
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 20px;
            margin: 30px 0;
        }

        .main-content.nocategory {
            grid-template-columns: 1fr;
        }

        @@media (max-width: 768px) {
            .main-content {
                grid-template-columns: 1fr;
            }

            header {
                padding: 1rem 0;
            }

            .navbar-brand {
                font-size: 18px;
            }
        }

        .btn-primary {
            background: var(--primary-color);
            border: none;
        }

        .btn-primary:hover {
            background: var(--secondary-color);
        }

        .alert {
            border-radius: 8px;
        }
    </style>
</head>

<body>
    <!-- Header -->
    <header class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <i class="fas fa-microchip"></i>TechnoShop
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <form class="d-flex me-auto" method="get" asp-controller="Home" asp-action="Index">
                    <input class="form-control me-2" type="search" name="searchQuery" placeholder="Tìm kiếm sản phẩm" value="@(ViewData["SearchQuery"] ?? "")" aria-label="Tìm kiếm" />
                    <input type="hidden" name="category" value="@(ViewData["CurrentCategory"] ?? "")" />
                    <button class="btn btn-outline-light" type="submit"><i class="fas fa-search"></i></button>
                </form>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="fas fa-home"></i> Trang chủ</a>
                    </li>

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="btn btn-nav btn-nav-ghost me-2" asp-controller="Admin" asp-action="Index">
                                    <i class="fas fa-user-shield"></i> Quản trị
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-nav btn-nav-ghost me-2" asp-controller="Admin" asp-action="Orders">
                                    <i class="fas fa-list-alt"></i> Đơn hàng
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="btn btn-nav btn-nav-primary" href="/Account/Logout"><i class="fas fa-sign-out-alt me-1"></i> Đăng xuất</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-nav btn-nav-primary me-2" href="/Account/Login"><i class="fas fa-sign-in-alt me-1"></i> Đăng nhập</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-nav btn-nav-ghost" href="/Account/Register"><i class="fas fa-user-plus me-1"></i> Đăng ký</a>
                        </li>
                    }

                    <li class="nav-item">
                        <vc:cart-summary />
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <div class="content-wrapper">
        <div class="container-fluid">
            @{ 
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                bool showCategory = currentController == "Home" && currentAction == "Index";
                var contentClass = showCategory ? "" : "nocategory";
            }

            <div class="main-content @contentClass">
                @if (showCategory)
                {
                    <aside id="categories" class="categories-section">
                        <h5 class="mb-3"><i class="fas fa-tag"></i> Danh mục</h5>
                        <vc:navigation-menu />
                    </aside>
                }
                <main class="content-area">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <vc:footer />
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP28nzcsEzD7YL8l1eoIl2QsRkP7b7u"
        crossorigin="anonymous"></script>
</body>

</html>